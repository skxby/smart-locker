          "name": "journal_epoch",
          "type": "uuid"
        },
        {
          "name": "command_id",
          "type": "uuid"
        }
      ],
      "response": [
        {
          "name": "operation_id",
          "type": "uuid"
        },
        {
          "name": "command_id",
          "type": "uuid"
        },
        {
          "name": "command_state",
          "type": "u8",
          "enum_ref": "command_state"
        },
        {
          "name": "action_no",
          "type": "u64"
        },
        {
          "name": "command_session_id",
          "type": "uuid"
        },
        {
          "name": "command_boot_id",
          "type": "u64"
        },
        {
          "name": "physical_revision",
          "type": "u64"
        },
        {
          "name": "reason",
          "type": "u16",
          "enum_ref": "wire_result"
        }
      ]
