{
  "contract_version": "0.2.1",
  "status": "DESIGN_REVIEW",
  "class_order": [
    "empty",
    "heat_gun",
    "multimeter",
    "oscilloscope",
    "power_supply",
    "soldering_iron",
    "wire_cutter"
  ],
  "transport": {
    "path": "/run/locker/vision.sock",
    "type": "AF_UNIX SOCK_SEQPACKET",
    "request_max_bytes": 8192,
    "response_max_bytes": 16384,
    "max_inflight_captures": 1,
    "queue_capacity": 4,
    "peer": "service UID/PID/start-instance verified; no TCP listener"
  },
  "schemas": {
    "VisionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "VisionGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "journal_epoch",
        "boot_id",
        "physical_revision",
        "host_session_id"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/components/schemas/DeviceId"
        },
        "journal_epoch": {
          "$ref": "#/components/schemas/Uuid"
        },
        "boot_id": {
          "$ref": "#/components/schemas/U64"
        },
        "physical_revision": {
          "$ref": "#/components/schemas/U64"
        },
        "host_session_id": {
          "$ref": "#/components/schemas/Uuid"
        }
      }
    },
    "VisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "expected_class",
        "bundle_sha256",
        "pipeline_sha256",
        "camera_profile_sha256",
        "policy_sha256",
        "threshold_ppm",
        "margin_ppm",
        "thresholds_validated",
        "frame_count",
        "min_frame_gap_ms",
        "capture_deadline_ms",
        "max_result_age_ms"
      ],
      "properties": {
        "mode": {
          "enum": [
            "DISABLED_FOR_FOUNDATION",
            "SHADOW",
            "REQUIRED"
          ]
        },
        "expected_class": {
          "enum": [
            "heat_gun",
            "multimeter",
            "oscilloscope",
            "power_supply",
            "soldering_iron",
            "wire_cutter"
          ]
        },
        "bundle_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pipeline_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "camera_profile_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "threshold_ppm": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "margin_ppm": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "thresholds_validated": {
          "type": "boolean"
        },
        "frame_count": {
          "const": 3
        },
        "min_frame_gap_ms": {
          "const": 100
        },
        "capture_deadline_ms": {
          "const": 3000
        },
        "max_result_age_ms": {
          "const": 2000,
          "description": "Initial Core acceptance freshness only; committed evidence remains guard-bound during the original 120-second WAIT_CONFIRM window."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "REQUIRED"
              }
            }
          },
          "then": {
            "properties": {
              "bundle_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "pipeline_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "camera_profile_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "threshold_ppm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "margin_ppm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "thresholds_validated": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "VisionFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "captured_mono_ms",
        "frame_sha256",
        "quality",
        "scores_ppm",
        "inference_ms"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/components/schemas/U64"
        },
        "captured_mono_ms": {
          "$ref": "#/components/schemas/U64",
          "description": "Conservative exposure-start lower bound: SOE timestamp or driver timestamp minus a verified exposure/pipeline upper bound stored in camera profile. MONOTONIC alone is insufficient."
        },
        "frame_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quality": {
          "enum": [
            "VALID",
            "DARK",
            "BLURRED",
            "OCCLUDED",
            "INVALID"
          ]
        },
        "scores_ppm": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "minItems": 7,
          "maxItems": 7
        },
        "inference_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "VisionCaptureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "capture_id",
        "operation_id",
        "phase",
        "slot_id",
        "camera_id",
        "service_instance_id",
        "expected_worker_instance_id",
        "expected_camera_generation",
        "guard",
        "issued_mono_ms",
        "deadline_mono_ms",
        "bundle_sha256",
        "pipeline_sha256",
        "camera_profile_sha256",
        "policy_sha256",
        "frame_count"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "CAPTURE"
        },
        "capture_id": {
          "$ref": "#/components/schemas/Uuid"
        },
        "operation_id": {
          "$ref": "#/components/schemas/Uuid"
        },
        "phase": {
          "enum": [
            "PRE_ACCESS",
            "POST_CLOSE"
          ]
        },
        "slot_id": {
          "const": 1
        },
        "camera_id": {
          "const": "slot-1"
