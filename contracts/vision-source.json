        "service_instance_id": {
          "$ref": "#/components/schemas/Uuid"
        },
        "expected_worker_instance_id": {
          "$ref": "#/components/schemas/Uuid"
        },
        "expected_camera_generation": {
          "$ref": "#/components/schemas/Uuid"
        },
        "guard": {
          "$ref": "#/components/schemas/VisionGuard"
        },
        "issued_mono_ms": {
          "$ref": "#/components/schemas/U64"
        },
        "deadline_mono_ms": {
          "$ref": "#/components/schemas/U64"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pipeline_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "camera_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frame_count": {
          "const": 3
        }
      }
    },
    "VisionCaptureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "capture_id",
        "operation_id",
        "phase",
