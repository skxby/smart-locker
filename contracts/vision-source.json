        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/VisionFrame"
          },
          "minItems": 0,
          "maxItems": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "OK"
              }
            }
          },
          "then": {
            "properties": {
              "frames": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VisionFrame"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      ]
    },
